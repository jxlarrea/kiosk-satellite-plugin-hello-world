      {
        "key": "showOnStart",
        "type": "boolean",
        "title": "Show window when enabled",
        "default": true
      }
    ],
    "commands": [
      {
        "id": "show",
        "title": "Show window"
      },
      {
        "id": "hide",
        "title": "Hide window"
      }
    ]
  },
  "download": {
    "tag": "v1.0.0",
