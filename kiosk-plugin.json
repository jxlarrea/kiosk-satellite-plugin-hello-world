{
  "schemaVersion": 1,
  "manifest": {
    "schemaVersion": 1,
    "id": "hello-world",
    "name": "Hello World",
    "version": "1.0.0",
    "apiVersion": 1,
    "minAndroidSdk": 24,
    "entryClass": "me.jxl.kiosk.plugins.hello.HelloWorldPlugin",
